# Whitelist: ignore everything, then allow only what is meant to be published.
*
!.gitignore
!LICENSE
!README.md
!scripts/
!scripts/*.sh
!tools/
!tools/*.py
!examples/
!examples/*.csv
!examples/*.sls
!examples/*.json
!round2/
!round2/README.md
!round2/tools/
!round2/tools/*.py
!round2/examples/
!round2/examples/*.csv
!round2/states/
!round2/states/*/
!round2/states/*/*.sls
!round2/states/_grains/*.py
!round2/sql/
!round2/sql/*.sql
!round2/grafana/
!round2/grafana/*.py
!round2/grafana/*.json
